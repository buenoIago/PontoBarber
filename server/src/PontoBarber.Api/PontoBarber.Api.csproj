<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PontoBarber.Aplicacao\PontoBarber.Aplicacao.csproj" />
    <ProjectReference Include="..\PontoBarber.Infra\PontoBarber.Infra.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PontoBarber.Testes.Integracao</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ADR-033: copia o build da SPA para o output/publicação, sem versionar artefatos. -->
  <Target Name="CopiarAssetsSpa" AfterTargets="Build;Publish">
    <ItemGroup>
      <_AssetSpa Include="../../../client/dist/ponto-barber-web/browser/**/*"
                 Condition="Exists('../../../client/dist/ponto-barber-web/browser/index.html')" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetSpa)"
          DestinationFiles="@(_AssetSpa->'$(TargetDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_AssetSpa)"
          DestinationFiles="@(_AssetSpa->'$(PublishDir)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>
