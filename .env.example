# Modelo de variáveis de ambiente do PontoBarber.
# Nunca comite valores reais. Use variáveis do shell/secret manager.
# Nenhum valor abaixo é credencial válida.

# PostgreSQL usado pela API (formato aceito por Npgsql).
# Exporte no shell: a API não carrega .env automaticamente.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pontobarber;Username=pontobarber;Password=<SENHA_DO_AMBIENTE>

# PostgreSQL local (deploy/docker/docker-compose.postgres.yml).
# A API NÃO lê .env automaticamente: exporte estas variáveis no shell.
POSTGRES_USER=pontobarber
POSTGRES_PASSWORD=<SENHA_DO_AMBIENTE>

# Intervalo do adaptador provisório de processos periódicos (minutos).
Jobs__IntervaloMinutos=5

# Endereço de escuta da API.
ASPNETCORE_URLS=http://localhost:5080

# Opcional: conexão PostgreSQL isolada para testes de integração/carga quando
# o Testcontainers não puder iniciar um container. Nunca use banco compartilhado.
PONTOBARBER_TEST_CONNECTION=Host=localhost;Port=5432;Database=pontobarber_tests;Username=pontobarber;Password=<SENHA_DO_AMBIENTE>
