# Modelo de variáveis de ambiente do PontoBarber.
# Nunca comite valores reais. Use variáveis do shell/secret manager.
# Nenhum valor abaixo é credencial válida.

# SQL Server usado pela API (formato aceito por Microsoft.Data.SqlClient).
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=PontoBarber;User Id=sa;Password=<SENHA_DO_AMBIENTE>;TrustServerCertificate=True;Encrypt=False

# Intervalo do adaptador provisório de processos periódicos (minutos).
Jobs__IntervaloMinutos=5

# Endereço de escuta da API.
ASPNETCORE_URLS=http://localhost:5080

# Senha temporária do container descartável de testes locais (documentada em docs/EXECUCAO-LOCAL.md).
PB_SQL_SA_PASSWORD=<SENHA_TEMPORARIA_DO_SHELL>

# Opcional: conexão para o harness de carga quando o daemon Docker não estiver disponível.
PONTOBARBER_TEST_CONNECTION=Server=(localdb)\MSSQLLocalDB;Database=master;Integrated Security=True;TrustServerCertificate=True
